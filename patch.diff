+
+    // External ground-truth pin, counterpart to
+    // metal::kernels::tests::test_rope_ref_matches_llama_cpp_ground_truth.
+    //
+    // Every other test in this module uses CandleTensor::zeros() as input.
+    // Rotating an all-zero vector gives zero back under ANY pairing
+    // convention, correct or not -- so none of those tests could have
+    // caught the split-half/interleaved bug even in principle, regardless
+    // of what they asserted on. This one uses real, non-zero pre-RoPE Q
+    // values pulled from llama.cpp's ground_truth.txt (blk.0, position 1,
+    // head 0) and checks against llama.cpp's actual post-RoPE output,
+    // theta=500000.0 (Llama 3's real rope_theta).
+    #[test]
+    fn test_apply_cpu_rope_matches_llama_cpp_ground_truth() {
+        let head_dim = 64usize;
+        let mut data = vec![0.0f32; 2 * head_dim]; // seq_len=2, n_heads=1
+        data[head_dim] = 0.4288; // position 1, channel 0 (pre-RoPE Q)
+        data[head_dim + 1] = -0.2099; // position 1, channel 1 (pre-RoPE Q)
+        data[head_dim + 2] = 1.1587; // position 1, channel 2 (pre-RoPE Q, untouched by pair i=0)
+
+        let x =
+            CandleTensor::from_slice(&data, &Shape::new(&[1, 2, 1, head_dim]), &cpu()).unwrap();
+        let out = Attention::<CandleBackend>::apply_cpu_rope(&x, 0, 500000.0, head_dim).unwrap();
+        let out = out.to_vec_f32().unwrap();
+
+        assert!(
+            (out[head_dim] - 0.4083).abs() < 1e-3,
+            "channel 0 @ pos 1: got {}, want 0.4083 (llama.cpp ground truth)",
+            out[head_dim]
+        );
+        assert!(
+            (out[head_dim + 1] - 0.2474).abs() < 1e-3,
+            "channel 1 @ pos 1: got {}, want 0.2474 (llama.cpp ground truth)",
+            out[head_dim + 1]
+        );
+    }